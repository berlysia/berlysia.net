{
  "name": "berlysia-net",
  "version": "0.0.0",
  "description": "",
  "license": "UNLICENSED",
  "author": "berlysia <berlysia@gmail.com>",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "run-s build:seed build:partytown build:client build:ssg",
    "build:seed": "tsx --tsconfig ./tsconfig.script.json app/seeds/build.ts",
    "build:partytown": "partytown copylib public/~partytown",
    "build:client": "vite build --mode client",
    "build:ssg": "vite build",
    "preview": "vite preview --outDir dist",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "jest --passWithNoTests",
    "test:vrt:ci": "playwright test",
    "test:vrt": "docker run --rm --user $(id -u):$(id -g) --volume $(pwd):/workdir/ --workdir /workdir/ -it mcr.microsoft.com/playwright:v1.63.0-jammy /bin/bash -c 'pnpm test:vrt:ci'",
    "test:vrt:update": "docker run --rm --user $(id -u):$(id -g) --volume $(pwd):/workdir/ --workdir /workdir/ -it mcr.microsoft.com/playwright:v1.63.0-jammy /bin/bash -c 'pnpm test:vrt:ci -u'",
    "typecheck": "tsc --noEmit",
    "prepare": "git config --local core.hooksPath .githooks && echo 'githooks installed' || echo 'githooks install failed'",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@qwik.dev/partytown": "0.14.4",
    "clsx": "2.1.1",
    "fs-extra": "11.4.0",
    "hono": "4.13.8",
    "rss-parser": "3.13.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@hono/vite-ssg": "0.3.3",
    "@playwright/test": "1.63.0",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.6",
    "autoprefixer": "10.6.1",
    "honox": "0.1.61",
    "jest": "29.7.0",
    "lint-staged": "17.5.1",
    "npm-run-all2": "6.2.6",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tailwindcss-logical": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "lint-staged": {
    "*.{[jt]s,[jt]sx,[cm][jt]s}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,css,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
